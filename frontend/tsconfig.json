{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/button": ["./src/app/ui/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/app/ui/utils/src/index.ts"],
      "@spartan-ng/helm/card": ["./src/app/ui/card/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/app/ui/input/src/index.ts"],
      "@spartan-ng/helm/badge": ["./src/app/ui/badge/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./src/app/ui/textarea/src/index.ts"],
      "@spartan-ng/helm/switch": ["./src/app/ui/switch/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./src/app/ui/checkbox/src/index.ts"],
      "@spartan-ng/helm/tabs": ["./src/app/ui/tabs/src/index.ts"],
      "@spartan-ng/helm/progress": ["./src/app/ui/progress/src/index.ts"],
      "@spartan-ng/helm/avatar": ["./src/app/ui/avatar/src/index.ts"],
      "@spartan-ng/helm/separator": ["./src/app/ui/separator/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
